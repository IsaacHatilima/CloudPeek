{
  "name": "cloudpeek",
  "description": "Cloud Peek \u2014 a mobile monitor for Laravel Cloud.",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "bun run typecheck && bun run lint && bun run test:coverage",
    "api:types": "node scripts/generate-cloud-api-types.mjs && node scripts/generate-cloud-api-operations.mjs",
    "test:live": "jest --config jest.live.config.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaacHatilima/CloudPeek.git"
  },
  "homepage": "https://github.com/IsaacHatilima/CloudPeek#readme",
  "bugs": {
    "url": "https://github.com/IsaacHatilima/CloudPeek/issues"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.3.9"
  }
}
