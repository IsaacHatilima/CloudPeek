{
  "expo": {
    "name": "Cloud Peek",
    "slug": "cloudpeek",
    "scheme": "cloudpeek",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cloudpeek.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "dark": "./assets/icons/ios-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-foreground.png",
        "backgroundColor": "#0EA5E9"
      },
      "package": "com.cloudpeek.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cloud Peek uses your photo library to pick an application avatar."
        }
      ]
    ]
  }
}
